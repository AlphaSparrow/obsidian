{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 25,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "installDir": "${sourceDir}/install/${presetName}",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "dev",
            "displayName": "Development (Debug, Sanitizers)",
            "description": "Fast iteration: Debug build with ASan+UBSan, no optional backends",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "OBSIDIAN_ENABLE_CUDA": "OFF",
                "OBSIDIAN_ENABLE_MPI": "OFF",
                "OBSIDIAN_ENABLE_GRPC": "OFF",
                "OBSIDIAN_ENABLE_RUST": "OFF",
                "OBSIDIAN_ENABLE_SANITIZERS": "ON",
                "OBSIDIAN_ENABLE_TESTS": "ON"
            }
        },
        {
            "name": "dev-full",
            "displayName": "Development Full (Debug, All Backends)",
            "description": "Debug build with all optional backends enabled",
            "inherits": "dev",
            "cacheVariables": {
                "OBSIDIAN_ENABLE_CUDA": "ON",
                "OBSIDIAN_ENABLE_MPI": "ON",
                "OBSIDIAN_ENABLE_GRPC": "ON",
                "OBSIDIAN_ENABLE_RUST": "ON"
            }
        },
        {
            "name": "release",
            "displayName": "Release (Optimised, LTO)",
            "description": "Production build: O3, LTO, stripped, no sanitizers",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "OBSIDIAN_ENABLE_LTO": "ON",
                "OBSIDIAN_ENABLE_CUDA": "OFF",
                "OBSIDIAN_ENABLE_MPI": "OFF",
                "OBSIDIAN_ENABLE_GRPC": "OFF",
                "OBSIDIAN_ENABLE_RUST": "OFF",
                "OBSIDIAN_ENABLE_TESTS": "OFF"
            }
        },
        {
            "name": "ci-linux-x64",
            "displayName": "CI — Linux x86_64 (GCC)",
            "description": "CI build for Linux x86_64 with all features",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/linux-x86_64.cmake",
                "OBSIDIAN_ENABLE_CUDA": "ON",
                "OBSIDIAN_ENABLE_MPI": "ON",
                "OBSIDIAN_ENABLE_GRPC": "ON",
                "OBSIDIAN_ENABLE_RUST": "ON",
                "OBSIDIAN_ENABLE_TESTS": "ON"
            }
        },
        {
            "name": "ci-linux-aarch64",
            "displayName": "CI — Linux aarch64 (Cross)",
            "description": "CI cross-compilation for Linux aarch64",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/linux-aarch64.cmake",
                "OBSIDIAN_ENABLE_CUDA": "OFF",
                "OBSIDIAN_ENABLE_MPI": "OFF",
                "OBSIDIAN_ENABLE_GRPC": "OFF",
                "OBSIDIAN_ENABLE_RUST": "OFF",
                "OBSIDIAN_ENABLE_TESTS": "OFF"
            }
        },
        {
            "name": "ci-windows-x64",
            "displayName": "CI — Windows x64 (MSVC)",
            "description": "CI build for Windows x64 with MSVC",
            "inherits": "base",
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/windows-x64-msvc.cmake",
                "OBSIDIAN_ENABLE_CUDA": "OFF",
                "OBSIDIAN_ENABLE_MPI": "OFF",
                "OBSIDIAN_ENABLE_GRPC": "OFF",
                "OBSIDIAN_ENABLE_RUST": "OFF",
                "OBSIDIAN_ENABLE_TESTS": "ON"
            }
        },
        {
            "name": "ci-macos-universal",
            "displayName": "CI — macOS Universal (AppleClang)",
            "description": "CI build for macOS fat binary (x86_64 + arm64), no CUDA",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/macos-universal.cmake",
                "OBSIDIAN_ENABLE_CUDA": "OFF",
                "OBSIDIAN_ENABLE_MPI": "OFF",
                "OBSIDIAN_ENABLE_GRPC": "OFF",
                "OBSIDIAN_ENABLE_RUST": "OFF",
                "OBSIDIAN_ENABLE_TESTS": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "dev",
            "configurePreset": "dev"
        },
        {
            "name": "dev-full",
            "configurePreset": "dev-full"
        },
        {
            "name": "release",
            "configurePreset": "release"
        },
        {
            "name": "ci-linux-x64",
            "configurePreset": "ci-linux-x64"
        },
        {
            "name": "ci-windows-x64",
            "configurePreset": "ci-windows-x64"
        },
        {
            "name": "ci-macos-universal",
            "configurePreset": "ci-macos-universal"
        }
    ]
}
